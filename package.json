{
  "name": "pyrevit-extension-builder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
